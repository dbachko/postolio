# Core runtime
NODE_ENV=prod
ENVIRONMENT=prod
PORT=3000
WEB_PORT=80

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postolio
ASSETS_DATABASE_URL=postgresql://postgres:postgres@postgres_assets:5432/postolio_assets
REDIS_URL=redis://redis:6379

# Auth and service tokens
JWT_SECRET=generate-a-secure-random-secret
ASSETS_API_SERVICE_TOKEN=change-me-assets-api
ASSETS_SERVICE_TOKEN=change-me-assets-api

# Application URLs (used by API + frontend)
API_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
ASSETS_API_BASE_URL=http://assets-api:3002/assets-api/v1

# Email (choose SES or SMTP)
USE_AWS_SES=false
SES_FROM_EMAIL=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM=Postolio <noreply@example.com>

# AI/LLM providers
OPENAI_API_KEY=your-openai-key
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key

# Assets storage (S3-compatible)
ASSETS_S3_BUCKET=postolio-assets
ASSETS_CDN_DOMAIN=https://cdn.example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=aws-access-key
AWS_SECRET_ACCESS_KEY=aws-secret-key

# Optional analytics ingestor (profile: analytics)
LOG_LEVEL=info
TOKEN_SERVICE_URL=http://api:3000
DUMMY_ACCESS_TOKEN=
EVENT_BUS_NAME=postolio-default

# Frontend build flags (injected during image build)
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_FACEBOOK_APP_ID=your-facebook-app-id
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_FACEBOOK_ENABLED=true
VITE_AUTH_MAGIC_LINK_ENABLED=true
VITE_FEATURE_AI_SUGGESTIONS=true
VITE_FEATURE_VIDEO_SUPPORT=true
VITE_SENTRY_FRONTEND_DSN=
