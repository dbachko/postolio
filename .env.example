# Database Configuration
# PostgreSQL connection string for development
DATABASE_URL="postgresql://aiagency:aiagency123@localhost:5432/aiagency"

# JWT Authentication
# Generate a secure random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-here-make-it-long-and-random"

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Instagram API (for future Instagram integration)
# INSTAGRAM_APP_ID=""
# INSTAGRAM_APP_SECRET=""
# INSTAGRAM_REDIRECT_URI=""