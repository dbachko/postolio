# Database Configuration
# PostgreSQL connection string for development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postolio"

# JWT Authentication
# Generate a secure random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-here"

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Midjourney API Configuration
# Optional: For higher quality image generation
# Get these from your Discord server where you have Midjourney bot access
# SALAI_TOKEN: Your Discord token (from Discord Developer Tools)
# SERVER_ID: Discord server ID where Midjourney bot is present
# CHANNEL_ID: Discord channel ID where Midjourney operates
# If not configured, system will fallback to DALL-E for image generation
MIDJOURNEY_SALAI_TOKEN="your-discord-salai-token-here"
MIDJOURNEY_SERVER_ID="your-discord-server-id-here"
MIDJOURNEY_CHANNEL_ID="your-discord-channel-id-here"

# Google OAuth Configuration
# Set up OAuth 2.0 credentials in Google Cloud Console
# Get your credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Facebook OAuth Configuration (for user registration/login)
# Uses the same Meta App as Instagram but different redirect URI
FACEBOOK_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# Meta App Configuration for Instagram Graph API Integration
# Follow the setup guide in README.md to obtain these credentials
# Note: Instagram Basic Display API was deprecated Dec 4, 2024 - this uses Instagram Graph API
FACEBOOK_APP_ID="your-meta-app-id-here"
FACEBOOK_APP_SECRET="your-meta-app-secret-here"
INSTAGRAM_REDIRECT_URI="https://localhost:3000/api/auth/instagram/callback"

# Server Configuration
PORT=3000
NODE_ENV=development

# SSL Configuration (for HTTPS local development)
# Update these paths to match your local certificate locations
# SSL_CERT_PATH="./certs/localhost.crt"
# SSL_KEY_PATH="./certs/localhost.key"

# Optional: Redis Configuration (for advanced rate limiting and caching)
# REDIS_URL="redis://localhost:6379"

# AWS Scheduler Service Configuration (for production scheduling)
# Scheduler now authenticates exclusively via IAM SigV4; only API URL required
SCHEDULER_API_URL="https://your-scheduler-api.execute-api.region.amazonaws.com/prod"

# Publisher API Security (Optional)
# API key for Lambda publisher authentication (auto-generated in production)
# PUBLISHER_API_KEY="secure-publisher-key"
# Optional: Restrict publisher endpoint to specific IP addresses (comma-separated)
# Useful for limiting access to Lambda NAT Gateway IPs or specific services
# PUBLISHER_ALLOWED_IPS="10.0.0.1,10.0.0.2"

# Publisher endpoints available:
# POST /api/publisher/credentials - Fetch fresh Instagram credentials for publishing
# POST /api/publisher/content - Fetch fresh content details for publishing
# Both endpoints ensure Lambda always gets the latest data at publish time

# AWS Configuration (for production deployment)
AWS_REGION="us-east-1"
S3_IMAGES_BUCKET="your-s3-bucket-name"
CLOUDFRONT_DISTRIBUTION_ID="your-cloudfront-distribution-id"
CLOUDFRONT_DOMAIN="your-cloudfront-domain.cloudfront.net"

# Email Service Configuration
# Option 1: AWS SES (Recommended for Production)
USE_AWS_SES=true                          # Set to true to use AWS SES
SES_FROM_EMAIL=noreply@postolio.example         # Verified sender email in SES
# Note: In production on AWS, IAM role provides credentials automatically
# Run scripts/setup-aws-ses.sh to verify your domain and email

# Option 2: SMTP (For Development)
# For Gmail: Use app-specific password, not regular password
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Postolio" <noreply@postolio.example>
