# ============================================
# Postolio Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ============================================
# Environment & Server Configuration
# ============================================
NODE_ENV=dev                    # Environment: dev, staging, prod
ENVIRONMENT=dev                 # Deployment environment (same as NODE_ENV typically)
PORT=3000                       # API server port
ASSETS_API_PORT=3002            # Assets API port (kept separate to avoid conflicts when sourcing .env)
ASSETS_API_BASE_URL="http://localhost:3002/assets-api/v1"  # Internal HTTP base for Assets API
ASSETS_API_SERVICE_TOKEN="dev-assets-service-token"        # Token the main API/publisher use when calling the assets API
ASSETS_SERVICE_TOKEN="dev-assets-service-token"            # Token consumed by the assets API itself
LOG_LEVEL=debug                 # Logging level: debug, info, warn, error
LOG_PRETTY=false                # Pretty logs only in local TTY; CloudWatch must be JSON
FB_OAUTH_DEBUG=false            # Enable verbose Facebook/Instagram OAuth logging (tokens not logged)
POST_SEED_IMAGE_BASE=https://picsum.photos   # Dev seed images for posts (absolute URLs)
PLACEHOLDER_IMAGE_BASE=https://picsum.photos  # Runtime placeholder CDN for generated images
SKIP_IMAGE_GENERATION=1                      # Skip OpenAI/Midjourney image generation in dev
ASSETS_CDN_DOMAIN="https://localhost-assets-cdn.test"      # CDN domain served by the Assets stack

# ============================================
# Error Tracking / Observability
# ============================================
# Optional: Sentry DSN for backend services (API + microservices)
# When unset, backend Sentry integration is disabled.
SENTRY_BACKEND_DSN=""

# Optional: Sentry DSN for the frontend (Vite / React app)
# Injected as Vite env var during build (see GitHub Actions).
VITE_SENTRY_FRONTEND_DSN=""

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postolio"
ASSETS_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postolio_assets_dev"

# Alternative: Individual database credentials (used in production via secrets)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=postolio

# ============================================
# Redis Configuration
# ============================================
# For local development, you can use REDIS_URL
# For AWS/production, use REDIS_HOST and REDIS_PORT (automatically constructed)
REDIS_HOST=localhost
REDIS_PORT=6379
# Or use combined URL (alternative):
# REDIS_URL="redis://localhost:6379"

 

# ============================================
# Authentication Secrets
# ============================================
# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-here-generate-a-secure-random-string"

# Optional: Separate secret for refresh tokens
# REFRESH_TOKEN_SECRET="your-refresh-token-secret-here"

# Optional: JWT expiration time
# JWT_EXPIRES_IN="15m"

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
# Default model should be broadly available. Examples: gpt-4o-mini, gpt-4o
LLM_DEFAULT_MODEL=gpt-4o-mini

# Caption generation tuning (optional)
# Increase temperature and penalties to enforce variety in captions
LLM_CAPTION_TEMPERATURE=0.95
LLM_PRESENCE_PENALTY=0.6
LLM_FREQUENCY_PENALTY=0.5
LLM_TOP_P=0.9
# Comma-separated phrases to avoid as starting openers
# Example includes common generic hooks often repeated by models
LLM_BANNED_OPENERS="Ready to,Let's,Let’s,Dive into,Explore,What’s your favorite,What's your favorite,Share in the comments"

# Hashtag diversity tuning (optional)
LLM_BANNED_HASHTAGS="inspiration,community,brand,lifestyle,motivation"
# Max number of posts a single hashtag can appear in within a batch
HASHTAG_MAX_GLOBAL_REUSE=1
# Enforce per-post counts (generator already targets 5–10)
HASHTAG_MIN_PER_POST=5
HASHTAG_MAX_PER_POST=10

# Rolling window for diversity
# Number of recent posts to consider when avoiding repeats
ROLLING_WINDOW_POST_COUNT=20
# Optional: also limit to posts within N days (0 disables date filter)
ROLLING_WINDOW_DAYS=0

# Brand Analysis LLM tuning (non-sensitive; optional)
# Request timeout in milliseconds per LLM call
BRAND_ANALYSIS_LLM_TIMEOUT_MS=30000
# Max retry attempts for 429/5xx responses
BRAND_ANALYSIS_LLM_MAX_RETRIES=3
# Simple in-process rate limiting: max concurrent requests
BRAND_ANALYSIS_LLM_MAX_CONCURRENT=2
# Minimum milliseconds between LLM call starts
BRAND_ANALYSIS_LLM_MIN_INTERVAL_MS=100

# Brand Analysis learning synthesis tuning (optional)
# Extend the stopword list used to filter learning tokens (comma-separated)
BRAND_ANALYSIS_STOPWORDS="very,just,really,thing,things"
# Recency decay constant (in days) for learning signal weighting (default 30)
BRAND_ANALYSIS_DECAY_DAYS=30
# Scale factor converting learning topic weight into count increments (default 5)
BRAND_ANALYSIS_TOPIC_HINT_SCALE=5

# Brand Analysis trigger settings
# Brand Analysis now runs only on explicit actions:
# - When Instagram is connected (OAuth callback)
# - When brand name/description is updated
# - When the user clicks "Run Analysis" in the UI
# The prior auto-trigger on /instagram/status refresh is disabled.
# Deprecated: BRAND_ANALYSIS_ON_CONNECT and BRAND_ANALYSIS_ON_CONNECT_DEBOUNCE_MS
# are no longer used.
BRAND_ANALYSIS_ON_CONNECT=false
BRAND_ANALYSIS_ON_CONNECT_DEBOUNCE_MS=86400000

# Optional internal API proxy (for orchestrator to fetch posts when events don't include them)
# Point to your API base URL and provide a service key that the API accepts via x-internal-key.
INTERNAL_API_URL=http://localhost:3000
INTERNAL_API_KEY=change-me

# ============================================
# Midjourney API Configuration (Optional)
# ============================================
# For higher quality image generation via Midjourney
# Get these from your Discord server where you have Midjourney bot access
# If not configured, system will fallback to DALL-E for image generation

# MIDJOURNEY_SALAI_TOKEN="your-discord-salai-token-here"  # Discord token from Developer Tools
# MIDJOURNEY_SERVER_ID="your-discord-server-id-here"      # Discord server ID
# MIDJOURNEY_CHANNEL_ID="your-discord-channel-id-here"    # Discord channel ID

# ============================================
# Google OAuth Configuration
# ============================================
# Set up OAuth 2.0 credentials in Google Cloud Console
# Get credentials from: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID="your-google-client-id-here"              # Public - can be exposed in frontend
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"      # Secret - keep secure
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"  # OAuth callback URL
# For Authorization Code (popup) flow we exchange codes with redirect_uri set to the
# origin of the calling page. In local dev that is usually http://localhost:5173.
# Override here only if your Origin header is unavailable.
GOOGLE_REDIRECT_ORIGIN="http://localhost:5173"

# ============================================
# Facebook OAuth Configuration
# ============================================
# For user registration/login via Facebook
# Uses the same Meta App as Instagram
# FACEBOOK_APP_SECRET is also used for Instagram webhook signature verification

FACEBOOK_APP_ID="your-facebook-app-id-here"                # Public - can be exposed
FACEBOOK_APP_SECRET="your-facebook-app-secret-here"        # Secret - keep secure, also used for webhook verification
FACEBOOK_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# Optional: Facebook Webhook verification token
# FACEBOOK_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# ============================================
# Instagram Graph API Configuration
# ============================================
# Note: Instagram Basic Display API was deprecated Dec 4, 2024
# This uses Instagram Graph API

INSTAGRAM_APP_ID="your-instagram-app-id-here"              # Usually same as FACEBOOK_APP_ID
INSTAGRAM_APP_SECRET="your-instagram-app-secret-here"      # Usually same as FACEBOOK_APP_SECRET
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# Instagram Webhooks (for DM Automation)
# Configure this token in your Meta App Dashboard under Webhooks
# Must match the verify token you set when subscribing to webhook events
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="postolio_webhook_secret"   # Change in production

# ============================================
# LinkedIn OAuth Configuration (Optional)
# ============================================
# LINKEDIN_CLIENT_ID="your-linkedin-client-id-here"
# LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret-here"

# ============================================
# TikTok OAuth Configuration (Optional)
# ============================================
# TIKTOK_CLIENT_KEY="your-tiktok-client-key-here"
# TIKTOK_CLIENT_SECRET="your-tiktok-client-secret-here"

# ============================================
# AWS Configuration (Production)
# ============================================
# These are automatically set in AWS ECS/Lambda environments
# Only needed for local testing of AWS features

AWS_REGION="us-east-1"                                      # AWS region

# AWS Credentials (only for local development - use IAM roles in production)
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# ============================================
# Lambda Function URLs (Production)
# ============================================
# These are automatically set via CDK deployment

# TOKEN_SERVICE_URL="https://token-service-url.lambda-url.us-east-1.on.aws"
# TOKEN_SERVICE_FUNCTION_URL="https://token-service-url.lambda-url.us-east-1.on.aws"

# ==========================
# Analytics Ingestor / Graph API
# ==========================
# Facebook Graph API version override (default v24.0). Used by API + connectors + ingestor.
FB_GRAPH_API_VERSION="v24.0"

# Ingestor rate limit per account per hour (default 200). Increase in dev to reduce throttling during tests.
RATE_LIMIT_PER_HOUR=200


# SCHEDULER_API_URL="https://scheduler-url.lambda-url.us-east-1.on.aws"
# CONTENT_SCHEDULER_URL="https://scheduler-url.lambda-url.us-east-1.on.aws"
# CONTENT_SCHEDULER_FUNCTION_URL="https://scheduler-url.lambda-url.us-east-1.on.aws"

# ============================================
# Email Service Configuration
# ============================================
# Option 1: AWS SES (Recommended for Production)
USE_AWS_SES=true
SES_FROM_EMAIL="noreply@postolio.example"                         # Verified sender email in AWS SES

# Option 2: SMTP (For Local Development)
# For Gmail: Use app-specific password, not regular password
# Guide: https://support.google.com/accounts/answer/185833

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false                                          # Use TLS (true) or STARTTLS (false)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="Postolio <noreply@postolio.example>"

# ============================================
# Application URLs
# ============================================
# These are used for CORS, redirects, and OAuth callbacks

API_URL="http://localhost:3000"                            # Backend API URL
FRONTEND_URL="http://localhost:5173"                       # Frontend application URL
APP_URL="http://localhost:5173"                            # Application base URL
CORS_ORIGIN="http://localhost:5173"                        # CORS allowed origins (can be comma-separated)

# Production URLs (for reference)
# API_URL="https://postolio.example"
# FRONTEND_URL="https://postolio.example"
# CORS_ORIGIN="https://postolio.example"

# ============================================
# Feature Flags
# ============================================
ENABLE_MONITORING=true                                     # Enable CloudWatch monitoring
ENABLE_AI_SUGGESTIONS=true                                 # Enable AI-powered suggestions
ENABLE_VIDEO_SUPPORT=false                                 # Enable video upload support
# ENABLE_CLOUDWATCH=true                                   # Alternative monitoring flag

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW=60000                                    # Rate limit window in ms (1 minute)
RATE_LIMIT_MAX_REQUESTS=100                                # Max requests per window
# Enable/disable API rate limiting (middleware) in non-prod environments.
# Default: disabled in dev to avoid 429s during testing. Set to 'true' to enable.
RATE_LIMIT_ENABLED=false

# ============================================
# SSL/HTTPS Configuration (Local Development)
# ============================================
# For HTTPS local development, specify paths to SSL certificates
# Uncomment and update paths to enable HTTPS

# SSL_CERT_PATH="./certs/localhost.crt"
# SSL_KEY_PATH="./certs/localhost.key"

# ============================================
# Advanced Configuration
# ============================================
# Optional: Enable query logging in Prisma
# LOG_QUERIES=true

# Optional: Application version
# APP_VERSION="1.0.0"

# ============================================
# CI/CD Environment Detection
# ============================================
# Automatically set by GitHub Actions
# CI=true
