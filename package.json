{
  "name": "postolio-monorepo",
  "private": true,
  "scripts": {
    "setup:ai-localhost": "bash scripts/setup-ai-localhost.sh",
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:api": "pnpm --filter api run build:deps && pnpm --filter api dev",
    "dev:web": "pnpm --filter @postolio/web^... run build && pnpm --filter @postolio/web dev",
    "dev:ingestor": "pnpm --filter @postolio/analytics-ingestor build && INGESTOR_LOOP_MS=60000 pnpm --filter @postolio/analytics-ingestor start",
    "dev:stack": "bash scripts/dev-all.sh",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{css,scss,js,jsx,ts,tsx,md,mdx,json,yml,yaml,html,graphql}\"",
    "format:check": "prettier --check \"**/*.{css,scss,js,jsx,ts,tsx,md,mdx,json,yml,yaml,html,graphql}\"",
    "ci:validate-migration": "echo \"ci:validate-migration has been inlined into prisma/schema + code review; no external script required.\""
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "husky": "^9.1.6",
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript-eslint": "^8.35.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.19.2",
    "turbo": "^2.0.9",
    "typescript": "^5.7.3",
    "playwright": "^1.55.0"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client"
    ],
    "overrides": {
      "@smithy/types": "^4.4.0",
      "@smithy/core": "^3.11.0"
    }
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.888.0"
  }
}
