{
  "name": "postolio",
  "version": "1.0.0",
  "description": "AI-powered Instagram content generation and management platform",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:with-migration": "./scripts/start-with-migration.sh",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:only": "./scripts/run-migrations-only.sh",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:db": "docker compose up -d",
    "start:all": "npm run dev:db && sleep 3 && concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "deploy:aws:dev": "./scripts/deploy-aws.sh dev",
    "deploy:aws:prod": "./scripts/deploy-aws.sh prod",
    "deploy:aws:destroy": "./scripts/deploy-aws.sh prod destroy"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudfront": "^3.772.0",
    "@aws-sdk/client-cloudwatch": "^3.864.0",
    "@aws-sdk/client-s3": "^3.772.0",
    "@aws-sdk/credential-provider-node": "^3.864.0",
    "@aws-sdk/protocol-http": "^3.370.0",
    "@aws-sdk/s3-request-presigner": "^3.772.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.2.0",
    "@react-oauth/google": "^0.12.2",
    "aws4-axios": "^3.4.0",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.57.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.2.0",
    "instagram-graph-api": "^7.0.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "midjourney": "^4.3.18",
    "node-fetch": "^3.3.2",
    "openai": "^4.77.3",
    "opossum": "^9.0.0",
    "prisma": "^6.2.0",
    "redis": "^5.6.1",
    "sharp": "^0.33.4",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.17.0",
    "@types/opossum": "^8.1.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
