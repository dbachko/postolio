{
  "name": "postolio-monorepo",
  "private": true,
  "scripts": {
    "setup:ai-localhost": "bash scripts/setup-ai-localhost.sh",
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:db": "docker compose up -d",
    "dev:api": "pnpm --filter api run build:deps && pnpm --filter api dev",
    "dev:web": "pnpm --filter @postolio/web^... run build && pnpm --filter @postolio/web dev",
    "dev:ingestor": "pnpm --filter @postolio/analytics-ingestor build && INGESTOR_LOOP_MS=60000 pnpm --filter @postolio/analytics-ingestor start",
    "dev:seed": "pnpm --filter api seed:dev --",
    "dev:stack": "bash scripts/dev-all.sh",
    "e2e:live": "pnpm --filter @postolio/web test:e2e:live",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "check:lockfile": "pnpm install --frozen-lockfile",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{css,scss,js,jsx,ts,tsx,md,mdx,json,yml,yaml,html,graphql}\"",
    "format:check": "prettier --check \"**/*.{css,scss,js,jsx,ts,tsx,md,mdx,json,yml,yaml,html,graphql}\"",
    "ci:validate-migration": "bash scripts/validate-prisma-migrations.sh",
    "dev:reset": "bash scripts/dev-all.sh --reset",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.1161.0"
  },
  "license": "Apache-2.0"
}
