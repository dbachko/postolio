{
  "name": "postolio-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.9",
    "typescript": "^5.7.3",
    "prettier": "^3.6.2",
    "@types/node": "^22.17.0"
  },
  "packageManager": "pnpm@9.9.0",
  "pnpm": {
    "overrides": {
      "@smithy/types": "^4.4.0"
    }
  }
}