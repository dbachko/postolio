{
  "name": "postolio-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Postolio application",
  "bin": {
    "postolio-infrastructure": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "postinstall": "npm --loglevel=error run prepare:layers",
    "prepare:layers": "cd lib/layers/powertools/nodejs && npm ci --no-audit --fund=false --loglevel=error && cd -"
  },
  "devDependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-cloudwatch": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-eventbridge": "^3.1161.0",
    "@aws-sdk/client-kms": "^3.1161.0",
    "@aws-sdk/client-lambda": "^3.1161.0",
    "@aws-sdk/client-mediaconvert": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-scheduler": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@postolio/tsconfig": "workspace:*",
    "@prisma/client": "^7.10.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1107.0",
    "aws-lambda": "^1.0.7",
    "aws-sdk-client-mock": "^4.1.0",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0",
    "cdk-nag": "^2.38.2",
    "esbuild": "^0.27.7",
    "form-data": "^4.0.6",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/core": "^3.979.1",
    "@postolio/aws": "workspace:^",
    "@postolio/observability": "workspace:^",
    "@postolio/service-parameters": "workspace:^",
    "@prisma/adapter-pg": "^7.10.1",
    "@smithy/core": "^3.38.1",
    "aws-cdk-lib": "^2.275.0",
    "aws-xray-sdk-core": "^3.12.0",
    "constructs": "^10.8.1",
    "pg": "^8.23.1"
  }
}
