{
  "name": "postolio-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Postolio application",
  "bin": {
    "postolio-infrastructure": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "postinstall": "npm run prepare:layers",
    "prepare:layers": "cd lib/layers/powertools/nodejs && npm install && cd -"
  },
  "devDependencies": {
    "@aws-lambda-powertools/logger": "^2.28.1",
    "@aws-lambda-powertools/metrics": "^2.28.1",
    "@aws-lambda-powertools/tracer": "^2.28.1",
    "@aws-sdk/client-cloudwatch": "^3.932.0",
    "@aws-sdk/client-dynamodb": "^3.932.0",
    "@aws-sdk/client-eventbridge": "^3.932.0",
    "@aws-sdk/client-kms": "^3.932.0",
    "@aws-sdk/client-lambda": "^3.932.0",
    "@aws-sdk/client-mediaconvert": "^3.932.0",
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/client-scheduler": "^3.932.0",
    "@aws-sdk/client-secrets-manager": "^3.932.0",
    "@aws-sdk/client-sqs": "^3.932.0",
    "@aws-sdk/lib-dynamodb": "^3.932.0",
    "@postolio/tsconfig": "workspace:*",
    "@prisma/client": "^6.19.0",
    "@types/aws-lambda": "^8.10.158",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1033.0",
    "aws-lambda": "^1.0.7",
    "aws-sdk-client-mock": "^4.1.0",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "cdk-nag": "^2.37.55",
    "esbuild": "^0.27.0",
    "form-data": "^4.0.4",
    "jest": "^30.2.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.932.0",
    "@aws-sdk/client-ssm": "^3.932.0",
    "@aws-sdk/core": "^3.932.0",
    "@postolio/aws": "workspace:^",
    "@postolio/observability": "workspace:^",
    "@postolio/service-parameters": "workspace:^",
    "@prisma/adapter-pg": "^6.19.0",
    "@smithy/core": "^3.18.5",
    "aws-cdk-lib": "^2.225.0",
    "aws-xray-sdk-core": "^3.11.0",
    "constructs": "^10.4.3",
    "pg": "^8.16.3"
  }
}
