{
  "name": "postolio-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Postolio application",
  "bin": {
    "postolio-infrastructure": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "postinstall": "npm run prepare:layers",
    "prepare:layers": "cd lib/layers/powertools/nodejs && npm install && cd -"
  },
  "devDependencies": {
    "@postolio/tsconfig": "workspace:*",
    "@aws-lambda-powertools/logger": "^2.25.1",
    "@aws-lambda-powertools/metrics": "^2.25.1",
    "@aws-lambda-powertools/tracer": "^2.25.1",
    "@aws-sdk/client-cloudwatch": "^3.876.0",
    "@aws-sdk/client-dynamodb": "^3.872.0",
    "@aws-sdk/client-eventbridge": "^3.873.0",
    "@aws-sdk/client-kms": "^3.873.0",
    "@aws-sdk/client-lambda": "^3.864.0",
    "@aws-sdk/client-mediaconvert": "^3.864.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-scheduler": "^3.864.0",
    "@aws-sdk/client-secrets-manager": "^3.872.0",
    "@aws-sdk/client-sqs": "^3.864.0",
    "@aws-sdk/lib-dynamodb": "^3.872.0",
    "@prisma/client": "^6.2.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/form-data": "^2.2.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.19.11",
    "aws-cdk": "2.1027.0",
    "aws-lambda": "^1.0.7",
    "aws-sdk-client-mock": "^4.1.0",
    "axios": "^1.7.2",
    "axios-retry": "^4.5.0",
    "cdk-nag": "^2.37.0",
    "esbuild": "^0.25.9",
    "form-data": "^4.0.0",
    "jest": "^29.6.2",
    "prisma": "^6.2.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2",
    "zod": "^4.1.3"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.873.0",
    "@aws-sdk/client-ssm": "^3.888.0",
    "@aws-sdk/core": "^3.883.0",
    "@postolio/aws": "workspace:^",
    "@postolio/service-parameters": "workspace:^",
    "@prisma/adapter-pg": "^6.2.0",
    "@smithy/core": "^3.11.0",
    "aws-cdk-lib": "^2.93.0",
    "aws-xray-sdk-core": "^3.10.3",
    "constructs": "^10.2.69",
    "pg": "^8.13.1"
  }
}
