{
  "name": "@postolio/aws",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --target node22 --out-dir dist --dts",
    "lint": "eslint src/**/*.ts"
  },
  "devDependencies": {
    "@postolio/tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/logger": "^2.28.1",
    "@aws-sdk/client-dynamodb": "^3.932.0",
    "@aws-sdk/client-eventbridge": "^3.932.0",
    "@aws-sdk/client-ssm": "^3.932.0",
    "@aws-sdk/credential-provider-node": "^3.932.0",
    "@aws-sdk/lib-dynamodb": "^3.932.0",
    "@postolio/database": "workspace:*",
    "@smithy/protocol-http": "^5.3.5",
    "@smithy/signature-v4": "^5.3.5",
    "aws-xray-sdk-core": "^3.11.0",
    "zod": "^4.1.12"
  }
}
