generator client {
  provider = "prisma-client-js"
  output   = "../assets-client"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id                String        @id @default(cuid())
  brandId           String        // Reference to main DB (no FK)
  uploadedBy        String        // Actor identifier from main DB (optional user)
  collectionId      String?

  // File metadata
  fileName          String
  fileType          AssetType     // image, video
  mimeType          String
  fileSize          Int
  width             Int?
  height            Int?
  duration          Int?          // for videos

  // Aspect ratio (computed from width/height)
  aspectRatio        String?      // "1:1", "4:5", "9:16", "16:9", "CUSTOM"
  aspectRatioDecimal Float?       // Decimal representation (e.g., 1.0, 0.8, 0.5625)
  orientationType    String?      // "portrait", "landscape", "square"

  // S3 storage
  s3Key             String        @unique
  s3Bucket          String
  thumbnailKey      String?       // Medium thumbnail (primary)
  thumbnailSmallKey String?       // 150x150
  thumbnailLargeKey String?       // 800x800

  // User metadata
  title             String?
  altText           String?       // WCAG required
  description       String?

  // AI analysis (cached)
  aiDescription           String?
  aiTags                  String[]
  aiPrimaryColors         String[]
  aiMood                  String?
  aiSubjects              String[]
  aiDescriptionEmbedding  Float[]   @default([]) // Embedding for AI image selection
  analyzedAt              DateTime?

  // Usage tracking
  usageCount        Int           @default(0)
  lastUsedAt        DateTime?

  // Processing
  processingStatus  ProcessingStatus @default(pending)
  processingError   String?

  // Lifecycle
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  archivedAt        DateTime?

  collection        AssetTaxonomyItem? @relation("AssetCollection", fields: [collectionId], references: [id])
  labelAssignments  AssetTaxonomyAssignment[]

  @@index([brandId, processingStatus])
  @@index([brandId, fileType])
  @@index([brandId, createdAt])
  @@index([aspectRatio])
  @@index([orientationType])
  @@index([brandId, aspectRatio])
  @@index([brandId, fileType, aspectRatio])
  @@index([brandId, collectionId, archivedAt, createdAt])
  @@map("assets")
}

model AssetTaxonomyItem {
  id          String       @id @default(cuid())
  brandId     String
  type        TaxonomyType
  parentId    String?
  sortOrder   Int?
  name        String
  nameNorm    String?
  color       String?
  isSystem    Boolean      @default(false)
  isHidden    Boolean      @default(false)
  isArchived  Boolean      @default(false)
  deletedAt   DateTime?
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent      AssetTaxonomyItem?  @relation("TaxonomyHierarchy", fields: [parentId], references: [id])
  children    AssetTaxonomyItem[] @relation("TaxonomyHierarchy")
  labelAssignments AssetTaxonomyAssignment[]
  assetsInCollection Asset[] @relation("AssetCollection")

  @@index([brandId, type])
  @@index([parentId])
  @@map("asset_taxonomy_items")
}

model AssetTaxonomyAssignment {
  assetId         String
  taxonomyItemId  String
  createdBy       String?
  createdAt       DateTime @default(now())

  asset        Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  taxonomyItem AssetTaxonomyItem  @relation(fields: [taxonomyItemId], references: [id], onDelete: Cascade)

  @@id([assetId, taxonomyItemId])
  @@index([taxonomyItemId, assetId])
  @@map("asset_taxonomy_assignments")
}

enum AssetType {
  image
  video
}

enum ProcessingStatus {
  pending
  processing
  thumbnails_complete
  ai_analyzed
  completed
  thumbnail_failed
  ai_analysis_failed
  failed
}

enum TaxonomyType {
  COLLECTION
  LABEL
}
