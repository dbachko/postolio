generator client {
  provider = "prisma-client-js"
}

generator lambdaClient {
  provider   = "prisma-client-js"
  output     = "../lambda-client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  instagramId       String?
  instagramUsername String?
  instagramToken    String?
  subscriptionTier  String             @default("free")
  deletedAt         DateTime?
  deletionReason    String?
  scheduledDeletion DateTime?
  timezone             String?            // User's preferred timezone (null = auto-detect)
  timezoneAutoDetected Boolean            @default(true) // Whether to auto-detect timezone
  
  // OAuth fields
  googleId          String?            @unique @map("googleid") // Google OAuth ID
  facebookId        String?            @unique @map("facebookid") // Facebook OAuth ID  
  profilePicture    String?            @map("profilepicture") // Profile picture URL from OAuth provider
  emailVerified     Boolean            @default(false) @map("emailverified") // Email verification status
  
  // Two-factor authentication fields
  twoFactorEnabled     Boolean        @default(false) @map("twofactorenabled")
  twoFactorMethod      String?        @map("twofactormethod") // 'totp', 'email', 'sms'
  twoFactorSecret      String?        @map("twofactorsecret") // Secret for TOTP
  twoFactorBackupCodes Json?          @map("twofactorbackupcodes") // Array of hashed backup codes
  twoFactorPhoneNumber String?        @map("twofactorphonenumber") // Phone number for SMS 2FA

  // Account security fields
  failedLoginAttempts  Int            @default(0) @map("failedloginattempts") // Count of failed login attempts
  accountLockedUntil   DateTime?      @map("accountlockeduntil") // Account lock expiration time
  
  brands            Brand[]
  modifiedCampaigns Campaign[]
  campaignDrafts    CampaignDraft[]

  @@index([email])
  @@index([accountLockedUntil])
  @@index([failedLoginAttempts])
  @@index([emailVerified])
  @@map("users")
}

model Brand {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  styleProfile         Json?
  preferences          Json?
  userId               String
  instagramPageId      String?
  instagramAccountId   String?
  instagramProfileData Json?
  engagementActive     Boolean            @default(false)
  engagementRules      Json?
  postingTimezone      String?            // Brand-specific posting timezone (null = use user's timezone)
  countryCode          String?            // ISO 3166-1 alpha-2 country code for seasonality/holidays
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns            Campaign[]
  content              Content[]
  campaignDrafts       CampaignDraft[]

  @@index([userId])
  @@index([createdAt])
  @@index([engagementActive])
  @@map("brands")
}

model Content {
  id                 String        @id @default(cuid())
  caption            String
  hashtags           String[]
  status             ContentStatus @default(draft)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  scheduledAt        DateTime?
  postedAt           DateTime?
  generationParams   Json?
  brandId            String
  campaignId         String?
  instagramPermalink String?
  instagramPostId    String?
  analytics          Json?
  schedulingError    String?
  s3ImageKey         String?       // S3 object key (e.g., images/2025-10-01/brandId/contentId.jpg)
  imageRegion        String?       // User region for compliance (EU, US, UK, etc.)
  retentionExpiresAt DateTime?     // Image retention expiry date based on region
  brand              Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign           Campaign?     @relation(fields: [campaignId], references: [id])

  @@index([brandId, status])
  @@index([scheduledAt])
  @@index([brandId, status, scheduledAt])
  @@index([campaignId])
  @@map("content")
}

enum CampaignTypeEnum {
  promotional
  educational
  seasonal
  thought_leadership
  custom
}

model Campaign {
  id                 String         @id @default(cuid())
  name               String
  brandId            String
  status             CampaignStatus @default(creating)
  config             Json
  priority           Int            @default(5)
  previewGenerated   Boolean        @default(false)
  errorMessage       String?
  // Marks the system-managed default campaign for a brand
  isDefault          Boolean        @default(false)
  // Visual identification: hex color code for calendar/timeline display
  color              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  lastModifiedAt     DateTime       @default(now()) @updatedAt
  lastModifiedById   String?
  modificationCount  Int            @default(0)
  // NEW: Campaign classification and structured metadata
  campaignType       CampaignTypeEnum @default(custom)
  contentPillars     Json?
  urgencyTactics     Json?
  seasonalContext    Json?
  brand              Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  lastModifiedBy     User?          @relation(fields: [lastModifiedById], references: [id])
  content            Content[]

  @@index([priority])
  @@index([status])
  @@index([campaignType])
  @@index([brandId, status])
  @@map("campaigns")
}

/// Stores server-side drafts of the campaign creation wizard for cross-device continuity
model CampaignDraft {
  id          String   @id @default(cuid())
  userId      String
  brandId     String
  wizardState Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([brandId])
  @@unique([userId, brandId])
  @@map("campaign_drafts")
}


enum ContentStatus {
  draft      // New content or unscheduled content (replaces pending, approved without scheduledAt, rejected)
  scheduled  // Content scheduled for future posting (replaces approved with scheduledAt)
  published  // Successfully posted to Instagram
  failed     // Publishing failed
  skipped    // Missed during campaign pause
}

enum CampaignStatus {
  creating
  preview
  active
  paused
  completed
  failed
  processing
}

model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  deviceFingerprint String?   @map("device_fingerprint")
  deviceName        String?   @map("device_name")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  location          Json?
  trusted           Boolean   @default(false)
  trustedUntil      DateTime? @map("trusted_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@index([deviceFingerprint])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("userid")
  email        String?
  eventType    String   @map("eventtype")
  ipAddress    String?  @map("ipaddress")
  userAgent    String?  @map("useragent")
  metadata     Json     @default("{}")
  success      Boolean  @default(true)
  errorMessage String?  @map("errormessage")
  createdAt    DateTime @default(now()) @map("createdat")

  @@index([userId])
  @@index([email])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Projection of latest brand style profile for fast reads
model BrandStyleProfileProjection {
  brandId          String   @id @map("brand_id")
  profileVersion   Int      @map("profile_version")
  promptSetVersion String?  @map("prompt_set_version")
  createdAt        DateTime @map("created_at")
  hasRecentDrift   Boolean  @default(false) @map("has_recent_drift")
  lastDriftAt      DateTime? @map("last_drift_at")
  archetype        String?
  primaryTones     String[] @db.Text
  primaryPalette   String[] @db.Text
  topicsTop        Json?    @map("topics_top")
  summaryProjection Json?   @map("summary_projection")
  checksum         String?
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@index([profileVersion])
  @@index([archetype])
  @@map("brand_style_profile_projection")
}
