{
  "name": "@postolio/service-parameters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --target node24 --out-dir dist --dts",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1161.0"
  },
  "devDependencies": {
    "@postolio/tsconfig": "workspace:*",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
