{
  "name": "@postolio/assets-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "pnpm --filter @postolio/logger build && pnpm --filter @postolio/database-assets run build",
    "dev": "pnpm run dev:server",
    "dev:server": "tsx watch src/index.ts",
    "build:server": "pnpm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@postolio/database-assets": "workspace:*",
    "@postolio/logger": "workspace:*",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "nanoid": "^6.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@postolio/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
