{
  "name": "@postolio/assets-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run dev:server",
    "dev:server": "tsx watch src/index.ts",
    "build:server": "tsc -p tsconfig.server.json || true",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.723.0",
    "@aws-sdk/s3-request-presigner": "^3.723.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@postolio/database-assets": "workspace:*",
    "dotenv": "^17.2.2",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@postolio/tsconfig": "workspace:*",
    "@types/node": "^24.1.0",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
