{
  "extends": "@postolio/tsconfig/node-library.json",
  "compilerOptions": {
    "outDir": "server",
    "rootDir": "server",
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "dist"]
}

