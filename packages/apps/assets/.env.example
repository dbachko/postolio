# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3002

# Authentication (shared with main API)
JWT_SECRET=your-jwt-secret-here

# Database (PostgreSQL)
ASSETS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postolio_assets_dev

# AWS S3 Configuration
ASSETS_S3_BUCKET=postolio-assets-dev-storage
ASSETS_CDN_DOMAIN=https://your-cloudfront-domain.cloudfront.net
AWS_REGION=us-east-1

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
