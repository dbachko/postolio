{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter \"api^...\" run build",
    "build": "tsc -p tsconfig.json && cp src/services/recipes/curated-recipes.json dist/services/recipes/curated-recipes.json",
    "dev": "tsx watch --exclude \"**/.prisma/**\" --exclude \"**/@prisma/client/**\" src/server.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "sync:curated": "node dist/scripts/sync-curated-recipes.js",
    "sync:curated:dev": "tsx src/scripts/sync-curated-recipes.ts",
    "status:curated": "node dist/scripts/curated-recipes-status.js",
    "status:curated:dev": "tsx src/scripts/curated-recipes-status.ts",
    "lint": "eslint --no-warn-ignored src/**/*.ts",
    "generate-secret": "node scripts/generate-jwt-secret.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudfront": "^3.1161.0",
    "@aws-sdk/client-cloudwatch": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-eventbridge": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-ses": "^3.1161.0",
    "@aws-sdk/credential-provider-node": "^3.972.92",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/websocket": "^11.3.6",
    "@google/generative-ai": "^0.24.1",
    "@postolio/assets-client": "workspace:*",
    "@postolio/aws": "workspace:*",
    "@postolio/connectors": "workspace:*",
    "@postolio/content-validation": "workspace:*",
    "@postolio/database": "workspace:*",
    "@postolio/database-assets": "workspace:*",
    "@postolio/errors": "workspace:*",
    "@postolio/logger": "workspace:*",
    "@postolio/observability": "workspace:*",
    "@postolio/service-parameters": "workspace:*",
    "@postolio/taxonomy": "workspace:*",
    "@smithy/signature-v4": "^5.7.5",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "aws4-axios": "^3.4.0",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "bullmq": "^5.81.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.3.1",
    "openai": "^6.49.0",
    "opossum": "^9.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0",
    "stripe": "^18.5.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@postolio/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/opossum": "^8.1.9",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
