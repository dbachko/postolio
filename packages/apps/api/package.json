{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter \"api^...\" run build",
    "build": "pnpm run build:deps && tsc -p tsconfig.json",
    "dev": "tsx watch --exclude \"**/.prisma/**\" --exclude \"**/@prisma/client/**\" src/server.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "sync:curated": "node dist/scripts/sync-curated-recipes.js",
    "sync:curated:dev": "tsx src/scripts/sync-curated-recipes.ts",
    "status:curated": "node dist/scripts/curated-recipes-status.js",
    "status:curated:dev": "tsx src/scripts/curated-recipes-status.ts",
    "lint": "eslint src/**/*.ts",
    "generate-secret": "node scripts/generate-jwt-secret.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudfront": "^3.956.0",
    "@aws-sdk/client-cloudwatch": "^3.956.0",
    "@aws-sdk/client-dynamodb": "^3.956.0",
    "@aws-sdk/client-eventbridge": "^3.956.0",
    "@aws-sdk/client-s3": "^3.956.0",
    "@aws-sdk/client-secrets-manager": "^3.956.0",
    "@aws-sdk/client-ses": "^3.956.0",
    "@aws-sdk/credential-provider-node": "^3.956.0",
    "@aws-sdk/lib-dynamodb": "^3.956.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "@postolio/assets-client": "workspace:*",
    "@postolio/aws": "workspace:*",
    "@postolio/connectors": "workspace:*",
    "@postolio/content-validation": "workspace:*",
    "@postolio/database": "workspace:*",
    "@postolio/database-assets": "workspace:*",
    "@postolio/errors": "workspace:*",
    "@postolio/logger": "workspace:*",
    "@postolio/observability": "workspace:*",
    "@postolio/service-parameters": "workspace:*",
    "@postolio/taxonomy": "workspace:*",
    "@smithy/signature-v4": "^5.3.7",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "aws4-axios": "^3.4.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "bullmq": "^5.66.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.8.2",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.11",
    "openai": "^6.15.0",
    "opossum": "^9.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "speakeasy": "^2.0.0",
    "stripe": "^18.0.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
