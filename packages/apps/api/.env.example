# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postolio

# JWT Authentication (REQUIRED)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=your-32-character-or-longer-secret-here

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI API
OPENAI_API_KEY=sk-...
# Optional LLM tuning for diversity
LLM_CAPTION_TEMPERATURE=0.95
LLM_PRESENCE_PENALTY=0.6
LLM_FREQUENCY_PENALTY=0.5
LLM_TOP_P=0.9
LLM_BANNED_OPENERS="Ready to,Let's,Let’s,Dive into,Explore,What’s your favorite,What's your favorite,Share in the comments"

# Hashtag diversity tuning (optional)
LLM_BANNED_HASHTAGS="inspiration,community,brand,lifestyle,motivation"
HASHTAG_MAX_GLOBAL_REUSE=1
HASHTAG_MIN_PER_POST=5
HASHTAG_MAX_PER_POST=10

# Rolling window for diversity
ROLLING_WINDOW_POST_COUNT=20
ROLLING_WINDOW_DAYS=0

# Facebook/Instagram OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Service (SendGrid, AWS SES, etc.)
EMAIL_FROM=noreply@postolio.example
SENDGRID_API_KEY=

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Environment
NODE_ENV=dev

# Port
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local HTTPS (development)
# If you run scripts/setup-ai-localhost.sh, the following certs will be created:
# SSL_CERT_PATH=../../certs/ai.localhost.pem
# SSL_KEY_PATH=../../certs/ai.localhost-key.pem

# Session
SESSION_SECRET=another-secure-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Enable/disable API rate limiting for dev/local (always enabled in prod)
RATE_LIMIT_ENABLED=false

# Monitoring
# Backend Sentry DSN (API and other backend services)
SENTRY_BACKEND_DSN=
NEW_RELIC_LICENSE_KEY=

# Feature Flags
ENABLE_2FA=true
ENABLE_OAUTH=true
ENABLE_MAGIC_LINKS=true
# Treat these environments as production for cookie security and CSP (comma-separated, case-insensitive)
# Example: PRODUCTION_ENVIRONMENTS=dev,def
PRODUCTION_ENVIRONMENTS=
AUTH_MAGIC_LINK_ENABLED=false # Set true to enable magic-link; without SMTP/SES, link is logged

# Signup Access Control
# Modes: open | closed | allowlist | invite_only
AUTH_SIGNUPS_MODE=open
# Comma-separated list of allowed emails (only used when AUTH_SIGNUPS_MODE=allowlist)
AUTH_ALLOWLIST_EMAILS=
# Optional: URL to your public waitlist/signup form (shown in error message)
WAITLIST_URL=
