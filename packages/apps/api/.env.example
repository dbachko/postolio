# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postolio

# JWT Authentication (REQUIRED)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=your-32-character-or-longer-secret-here

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI API
OPENAI_API_KEY=sk-...

# Facebook/Instagram OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Service (SendGrid, AWS SES, etc.)
EMAIL_FROM=noreply@postolio.example
SENDGRID_API_KEY=

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Port
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Session
SESSION_SECRET=another-secure-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Feature Flags
ENABLE_2FA=true
ENABLE_OAUTH=true
ENABLE_MAGIC_LINKS=true