{
  "extends": "@postolio/tsconfig/node-library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/__tests__/**", "**/*.test.ts"]
}
