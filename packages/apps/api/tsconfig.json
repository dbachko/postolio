{
  "extends": "@postolio/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "node",
    "downlevelIteration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
