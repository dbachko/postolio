{
  "name": "@postolio/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm -C ../../libs/csrf-client run build && pnpm -C ../../libs/calendar run build && pnpm -C ../../libs/content-validation run build",
    "build": "tsc -b && vite build",
    "lint": "eslint src && node scripts/check-component-modules.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:live": "npx playwright test -c playwright.live.config.ts",
    "test:screenshots": "npx playwright test -c playwright.screenshots.config.ts --project=chromium",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:ws": "npx playwright test tests/e2e/websocket",
    "playwright:install": "npx playwright install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@postolio/calendar": "workspace:^",
    "@postolio/content-validation": "workspace:*",
    "@postolio/csrf-client": "workspace:^",
