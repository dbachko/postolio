# Frontend environment configuration
# API base URL for backend communication
# 
# For development: leave empty to use the Vite proxy
# This ensures paths like /api/auth/* proxy correctly to the backend
# Example: /api/auth/login → https://localhost:3000/api/auth/login
# 
# For production: set to full API URL (e.g., https://postolio.example)
VITE_API_BASE_URL=

# Google OAuth Client ID
# Get this from https://console.cloud.google.com/apis/credentials
# Required for Google Sign-In functionality
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_AUTH_GOOGLE_ENABLED=true

# Facebook App ID
# Get this from https://developers.facebook.com/apps
# Required for Facebook Sign-In functionality
VITE_FACEBOOK_APP_ID=your-facebook-app-id-here
VITE_AUTH_FACEBOOK_ENABLED=true

# Magic link controls UI visibility only; backend status still validated
VITE_AUTH_MAGIC_LINK_ENABLED=true

# Recipe run dialog destination UI visibility (hidden by default)
VITE_FEATURE_RECIPE_DESTINATIONS=false

# Signup access control (UI messaging only; server enforces)
# Modes: open | closed | allowlist | invite_only
VITE_SIGNUPS_MODE=open
# Optional waitlist URL shown on Register/Login when signups are restricted
VITE_WAITLIST_URL=
# Optional: Uppy Companion URL to enable remote providers (Google Drive, Dropbox, etc.)
# For development only, you can try the public demo Companion at your own risk:
# VITE_UPPY_COMPANION_URL=https://companion.uppy.io
# In production, host your own Companion instance and set this to its URL.
VITE_UPPY_COMPANION_URL=
