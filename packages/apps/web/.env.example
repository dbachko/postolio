# Frontend environment configuration
# API base URL for backend communication
# 
# For development: Leave empty to use relative URLs with Vite proxy
# Vite proxy handles /api/* routes: /api/auth/login → https://localhost:3000/api/auth/login
# 
# For production: Set to full API URL (e.g., https://postolio.example)
VITE_API_BASE_URL=

# Google OAuth Client ID
# Get this from https://console.cloud.google.com/apis/credentials
# Required for Google Sign-In functionality
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Facebook App ID
# Get this from https://developers.facebook.com/apps
# Required for Facebook Sign-In functionality
VITE_FACEBOOK_APP_ID=your-facebook-app-id-here
