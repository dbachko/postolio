generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  instagramId       String?
  instagramUsername String?
  instagramToken    String?
  subscriptionTier  String             @default("free")
  brands            Brand[]
  campaignTemplates CampaignTemplate[]

  @@map("users")
}

model Brand {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  styleProfile         Json?
  preferences          Json?
  userId               String
  instagramAccessToken String?
  instagramPageId      String?
  instagramAccountId   String?
  instagramProfileData Json?
  engagementActive     Boolean            @default(false)
  engagementRules      Json?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignTemplates    CampaignTemplate[]
  campaigns            Campaign[]
  content              Content[]

  @@map("brands")
}

model Content {
  id                 String    @id @default(cuid())
  caption            String
  imageUrl           String?
  hashtags           String[]
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  scheduledAt        DateTime?
  postedAt           DateTime?
  generationParams   Json?
  brandId            String
  campaignId         String?
  instagramPermalink String?
  instagramPostId    String?
  analytics          Json?
  schedulingError    String?
  cdnImageUrl        String?
  imageRegion        String?
  retentionExpiresAt DateTime?
  s3ImageKey         String?
  brand              Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign           Campaign? @relation(fields: [campaignId], references: [id])

  @@map("content")
}

model Campaign {
  id               String    @id @default(cuid())
  name             String
  brandId          String
  status           String    @default("creating")
  config           Json
  priority         Int       @default(5)
  previewGenerated Boolean   @default(false)
  errorMessage     String?
  progress         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  brand            Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  content          Content[]

  @@index([priority])
  @@index([status])
  @@index([brandId, status])
  @@map("campaigns")
}

model CampaignTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?
  isPublic       Boolean  @default(false)
  templateConfig Json
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  brandId        String?
  brand          Brand?   @relation(fields: [brandId], references: [id])
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([brandId])
  @@index([isPublic])
  @@index([createdAt])
  @@map("campaign_templates")
}
